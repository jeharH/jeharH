" parent="1"><mxGeometry as="geometry" x="529.2372727630212" y="651.9328810308939" width="213.5482357523384" height="44.95679192187779" /></mxCell><mxCell id="v2n11" value="inicioEfetivo" style="shape=ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#215f51;fontColor=#173b42;fontSize=18.16535120981459;" vertex="1" parent="1"><mxGeometry as="geometry" x="769.1502451275044" y="651.9328810308939" width="187.85607126873708" height="44.95679192187779" /></mxCell><mxCell id="v2n12" value="fimEfetivo" style="shape=ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#215f51;fontColor=#173b42;fontSize=18.16535120981459;" vertex="1" parent="1"><mxGeometry as="geometry" x="982.6162826656182" y="651.9328810308939" width="160.56172280843018" height="44.95679192187779" /></mxCell><mxCell id="v2n13" value="registra" style="shape=rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#215f51;fontColor=#173b42;fontSize=18.16535120981459;" vertex="1" parent="1"><mxGeometry as="geometry" x="647.365643412885" y="440.7582208943859" width="181.65169556302493" height="63.578910887863174" /></mxCell><mxCell id="v2n14" value="substitui em" style="shape=rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#215f51;fontColor=#173b42;fontSize=18.16535120981459;" vertex="1" parent="1"><mxGeometry as="geometry" x="855.1300313400184" y="440.7582208943859" width="267.9407468798862" height="63.578910887863174" /></mxCell><mxCell id="p41" value="O titular da escala permanece identificado. Em uma substituição, o titular deve ser enfermeiro e diferente do substituto. O intervalo efetivo deve estar contido no período previsto; substituições do mesmo período não se sobrepõem. Hospital de origem não muda." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry as="geometry" x="36" y="731.8897637795277" width="1118.5511811023623" height="33" /></mxCell></root></mxGraphModel></diagram><diagram 