.8154395577577" width="207.39191349534605" height="33.18282683066228" /></mxCell><mxCell id="v6n11" value="&lt;u&gt;idResultado&lt;/u&gt;" style="shape=ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#215f51;fontColor=#173b42;fontSize=13.407934101723642;" vertex="1" parent="1"><mxGeometry as="geometry" x="401.7387657598512" y="597.0683076995631" width="133.9150938244903" height="33.18282683066228" /></mxCell><mxCell id="v6n12" value="descricaoResumo" style="shape=ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#215f51;fontColor=#173b42;fontSize=13.407934101723642;" vertex="1" parent="1"><mxGeometry as="geometry" x="554.89491541702" y="597.0683076995631" width="189.61701525669102" height="33.18282683066228" /></mxCell><mxCell id="v6n13" value="tipoResultado" style="shape=ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#215f51;fontColor=#173b42;fontSize=13.407934101723642;" vertex="1" parent="1"><mxGeometry as="geometry" x="763.4891854029381" y="597.0683076995631" width="152.87860542126313" height="33.18282683066228" /></mxCell><mxCell id="v6n14" value="descricaoDetalhada" style="shape=ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#215f51;fontColor=#173b42;fontSize=13.407934101723642;" vertex="1" parent="1"><mxGeometry as="geometry" x="935.5716396397473" y="597.0683076995631" width="210.95171999935368" height="33.18282683066228" /></mxCell><mxCell id="v6n15" value="produz" style="shape=rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#215f51;fontColor=#173b42;fontSize=13.407934101723642;" vertex="1" parent="1"><mxGeometry as="geometry" x="683.2219175062644" y="432.8193048823447" width="124.02607202776403" height="46.927903435373764" /></mxCell><mxCell id="p43" value="Cada solicitação representa um exame individual. O laboratório agendado deve cobrir o tipo pedido e ter contrato vigente na execução. Resultado exige exame realizado. Paciente e médico do pedido são obtidos pela consulta; não se duplicam essas informações." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry as="geometry" x="36" y="731.8897637795277" width="1118.5511811023623" height="33" /></mxCell></root></mxGraphModel></diagram></mxfile>