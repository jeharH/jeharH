"p160" value="Notação: retângulo = entidade; elipse = atributo; sublinhado = identificador; elipse dupla = multivalorado; losango = relacionamento. (mín,máx) junto à entidade indica suas participações. d = disjunta; o = sobreposta; linha dupla = total; simples = parcial. Subtipos herdam atributos, identificador e relacionamentos do supertipo." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry as="geometry" x="32" y="1110.5511811023623" width="1619.7795275590554" height="29" /></mxCell></root></mxGraphModel></diagram><diagram id="care-rev-2" name="01  |  ESTRUTURA HOSPITALAR"><mxGraphModel grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1190.5511811023623" pageHeight="841.8897637795277"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="01  |  ESTRUTURA HOSPITALAR" style="text;html=1;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="32" y="38" width="1126.5511811023623" height="30" /></mxCell><mxCell id="subtitle" value="Ampliação do modelo • atributos completos deste tema • caixas lilás indicam entidades detalhadas em outra página." style="text;html=1;fontSize=11;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="32" y="72" width="1126.5511811023623" height="25" /></mxCell><mxCell id="v0e0_0" style="endArrow=none;startArrow=none;strokeColor=#526b73;exitX=0.34288400633412436;exitY=1.0033333333333343;entryX=0.6162109654009887;entryY=0.013104755208869917;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="v0n0" target="v0n1"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="491.7676275860147" y="158.00969766020475" /><mxPoint x="487.8327224082978" y="162.43092185727585" /><mxPoint x="483.69104060737527" y="167.08375176295138" /><mxPoint x="479.4087765249222" y="171.8940477282293" /><mxPoint x="475.05212450261297" y="176.7876701041072" /><mxPoint x="470.68727888212186" y=