00378928982" height="48.59375142361692" /></mxCell><mxCell id="v4n11" value="acolhe" style="shape=rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#215f51;fontColor=#173b42;fontSize=13.883889309921091;" vertex="1" parent="1"><mxGeometry as="geometry" x="269.61320128621776" y="815.5908421937635" width="124.95500378928982" height="48.59375142361692" /></mxCell><mxCell id="v4n12" value="&lt;u&gt;idSolicInternacao&lt;/u&gt;" style="shape=ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#215f51;fontColor=#173b42;fontSize=13.883889309921091;" vertex="1" parent="1"><mxGeometry as="geometry" x="367.65359145376004" y="648.7074992704869" width="192.66812034270598" height="34.36075171699786" /></mxCell><mxCell id="v4n13" value="motivoInternacao" style="shape=ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#215f51;fontColor=#173b42;fontSize=13.883889309921091;" vertex="1" parent="1"><mxGeometry as="geometry" x="580.1461702448695" y="648.7074992704869" width="196.34804520430058" height="34.36075171699786" /></mxCell><mxCell id="v4n14" value="cirurgiaDeterminada" style="shape=ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#215f51;fontColor=#173b42;fontSize=13.883889309921091;" vertex="1" parent="1"><mxGeometry as="geometry" x="796.23988282574" y="648.7074992704869" width="225.79993959743615" height="34.36075171699786" /></mxCell><mxCell id="v4n15" value="dataHoraSolicitacao" style="shape=ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#215f51;fontColor=#173b42;fontSize=13.883889309921091;" vertex="1" parent="1"><mxGeometry as="geometry" x="1041.6633115738184" y="648.7074992704869" width="220.88920794851708" height="34.36075171699786" /></mxCell><mxCell id="v4n16" value="origina" style="shape=rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#215f51;fontColor=#173b42;fontSize=13.883889309921091;" vertex="1" parent="1"><mxGeometry as="geometry" x="844.0601627759012" y="471.5133553706439" width="130.15937969711374" height="48.59375142361692" /></mxCell><mxCell id="v4n17" value="é agendada como" style="shape=rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#215f51;fontColor=#173b42;fontSize=13.883889309921091;" vertex="1" parent="1"><mxGeometry as="geometry" x="1282.2700720230528" y="641.5909994171774" width="357.50876134153714" height="48.59375142361692" /></mxCell><mxCell id="v4n18" value="é designado a" style="shape=rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#215f51;fontColor=#173b42;fontSize=13.883889309921091;" vertex="1" parent="1"><mxGeometry as="geometry" x="44.00034709723275" y="641.5909994171774" width="303.7093844600584" height="48.59375142361692" /></mxCell><mxCell id="v4n19" value="compreende" style="shape=rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#215f51;fontColor=#173b42;fontSize=13.883889309921091;" vertex="1" parent="1"><mxGeometry as="geometry" x="1016.7410360680447" y="815.5908421937635" width="208.25625706541987" height="48.59375142361692" /></mxCell><mxCell id="p55" value="O pedido nasce de consulta de retorno. A internação preserva o paciente do pedido; o médico solicitante é recuperado pela consulta. Cirurgia associada à internação atende o mesmo paciente. Uma internação designa um único leito, sem transferências nesta hipótese. Agendamento não é ocupação: início e fim são efetivos; fim pode faltar durante a permanência. Intervalos [início,fim) do mesmo leito não se sobrepõem." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry as="geometry" x="36" y="1080.5511811023623" width="1611.7795275590554" height="33" /></mxCell></root></mxGraphModel></diagram><diagram id="care-rev-7" name="06 | Laboratórios e cobertura de exames"><mxGraphModel grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1190.5511811023623" pageHeight="841.8897637795277"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="