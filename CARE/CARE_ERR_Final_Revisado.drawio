" style="shape=ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#215f51;fontColor=#173b42;fontSize=16.22448525191897;" vertex="1" parent="1"><mxGeometry as="geometry" x="1156.9112648370185" y="751.1790625689295" width="159.17680235805184" height="40.15341069299044" /></mxCell><mxCell id="v3n19" value="recebe" style="shape=rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#215f51;fontColor=#173b42;fontSize=16.22448525191897;" vertex="1" parent="1"><mxGeometry as="geometry" x="306.63304379117574" y="696.2174425028733" width="148.0500503722858" height="56.78586062656892" /></mxCell><mxCell id="v3n20" value="responsável por" style="shape=rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#215f51;fontColor=#173b42;fontSize=16.22448525191897;" vertex="1" parent="1"><mxGeometry as="geometry" x="187.99149538651827" y="776.3258384342233" width="385.33314718160074" height="56.78586062656892" /></mxCell><mxCell id="v3n21" value="tipoConsulta&lt;br&gt;{primeira, retorno}" style="shape=ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#215f51;fontColor=#173b42;fontSize=16.22448525191897;" vertex="1" parent="1"><mxGeometry as="geometry" x="1387.4360523146465" y="800.1281723291166" width="252.39620482147745" height="65.96689121849857" /></mxCell><mxCell id="v3n22" value="d" style="shape=ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#215f51;fontColor=#173b42;fontSize=16.22448525191897;" vertex="1" parent="1"><mxGeometry as="geometry" x="927.3117191920942" y="821.4503097247622" width="35.49098036614649" height="35.49098036614649" /></mxCell><mxCell id="p54" value="CONSULTA, INTERNACAO e CIRURGIA são tipos distintos de evento e herdam idAtendimento. Uma cirurgia associada a uma internação tem seu próprio identificador. Data/hora efetiva e diagnóstico composto são obrigatórios quando o atendimento é concluído; podem faltar antes da realização." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontFam