7.83572689236707" /></mxCell><mxCell id="v5n9" value="cobre" style="shape=rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#215f51;fontColor=#173b42;fontSize=15.287996271460088;" vertex="1" parent="1"><mxGeometry as="geometry" x="927.9320700206695" y="337.54017323025727" width="122.30549897130784" height="53.50813983007302" /></mxCell><mxCell id="v5n10" value="valorCobrado" style="shape=ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#215f51;fontColor=#173b42;fontSize=15.287996271460088;" vertex="1" parent="1"><mxGeometry as="geometry" x="974.9415119556888" y="439.01535686180324" width="171.61158014620733" height="37.83572689236707" /></mxCell><mxCell id="p27" value="valorCobrado depende do par LABORATORIO–TIPO_EXAME. Os laboratórios pertencem ao credenciamento da holding CARE; não é necessária outra entidade para uma única holding. Endereço é simples porque o enunciado não exige seus componentes." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry as="geometry" x="36" y="731.8897637795277" width="1118.5511811023623" height="33" /></mxCell></root></mxGraphModel></diagram><diagram id="care-rev-8" name="07 | Pedidos, agendamento e resultado"><mxGraphModel grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1190.5511811023623" pageHeight="841.8897637795277"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="07 | Pedidos, agendamento e resultado" style="text;html=1;fontSize=22;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="32" y="38" width="1126.5511811023623" height="30" /></mxCell><mxCell id="subtitle" value="Ampliação do modelo • atributos completos deste tema • caixas lilás indicam entidades detalhadas em outra página." style="text;html=1;fontSize=11;align=left;" vertex="1" parent="1"><mxGeometry as="geometry" x="32" y="72" width="1126.5511811023623" height="25" /></mxCell><mxCell id="v6e0_0" style="